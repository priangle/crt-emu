+static int pick_lang(const char* shader_path)
+{
+    int lang = read_lang(shader_path);
+    if (lang < 0) lang = game_lang(shader_path);
+    if (lang < 0) lang = system_lang();
+    return lang < 0 ? 0 : lang;
+}
