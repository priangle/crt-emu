+    ini_path(path, sizeof(path), shader_path);
     char* text = read_file(path, NULL);
-    if (!text) return 0;
-    int lang = 0;
+    if (!text) return -1;
+    int lang = -1;
+    const char *ls, *le, *p, *vs, *ve;
+    for (p = text; (p = next_line(p, &ls, &le)) != NULL;)
+    {
+        if (!ini_line(ls, le, "lang", &vs, &ve)) continue;
+        int l = lang_index(vs, ve);
+        if (l >= 0) lang = l;
+    }
+    free(text);
+    return lang;
+}
